[MASTER]
# pylint configuration for Home Assistant integration
# Compatible with Black formatter (max-line-length=120)

[MESSAGES CONTROL]
# Disable checks that conflict with Black or are inappropriate for HA integrations
disable=
    # These are inherent to HA integration patterns and cannot be avoided
    import-error,                    # HA dependencies only available at runtime
    too-many-instance-attributes,    # HA entities require many framework attributes
    too-few-public-methods,          # HA flow steps and data classes are intentionally minimal
    too-many-arguments,              # Some coordinator methods need flexibility
    too-many-positional-arguments,   # Related to too-many-arguments
    too-many-locals,                 # Complex parsing methods need local variables
    duplicate-code,                  # Common HA setup boilerplate across platforms
    abstract-method,                 # HA uses async_ prefixed methods, not sync abstract methods

[FORMAT]
# Match Black's max line length setting (we use 120 instead of Black's default 88)
max-line-length=120

[BASIC]
# Allow single-letter variable names in common patterns
good-names=i,j,k,ex,_,id,r,g,b,h,s,v

[DESIGN]
# More lenient limits for HA integration patterns
max-attributes=12
max-args=7
max-locals=20

[SIMILARITIES]
# Ignore similarity in platform setup boilerplate
min-similarity-lines=10
