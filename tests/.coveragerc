[run]
source = ../custom_components/thermacell_liv
omit =
    ../*.py
    */__pycache__/*
    */debug/*
    */manual/*
    */integration/*
    */secrets.py

[report]
precision = 2
show_missing = True
skip_covered = False
fail_under = 90.0

exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
